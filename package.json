{
  "name": "thread-fileshare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:anatomy": "node scripts/build-anatomy.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test frontend/tests/*.test.ts",
    "test:backend": "python3 -m unittest discover -s backend/tests -v",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "6.4.3",
    "@playwright/test": "^1.56.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

